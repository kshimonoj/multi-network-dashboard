# --- dependencies / build artifacts ---
node_modules/
dist/
*.tsbuildinfo

# --- secrets ---
secrets/
.env
.env.*
!.env.example
*.pem
*.key
*.p12
service-account*.json

# --- runtime data (Central / Mist / GLP / Sheets の実データ・キャッシュ・state) ---
data/

# --- demo(34。録画の成果物。実データ(サイト名 / MAC / IP / org_id 等)が画面に写るため
#     動画・静止画・中間ファイルはコミットしない。録画スクリプトだけを管理する)---
#     work* / shots* は番号違い・v2 違いのディレクトリも生成されるため glob で網羅する
#     SRT はナレーション文言に実サイト名が混入した実績(55番)があるため対象外にする
demo/work*/
demo/shots*/
demo/*.mp4
demo/*.webm
demo/*.srt

# --- logs ---
*.log
logs/
npm-debug.log*

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
