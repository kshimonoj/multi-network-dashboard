# multi-network-dashboard — 環境変数のひな形
# 実ファイル(.env)は git 管理下に置かない(トークンを含むため)。

# claude CLI の認証トークン。
# macOS では claude の認証情報はログイン Keychain("Claude Code-credentials")に入っており、
# ~/.claude / ~/.claude.json をマウントしてもコンテナには引き継がれない。
#
# 取得方法(ホスト側で実行、長期トークンが発行される):
#   claude setup-token
#
# 短期の検証だけなら Keychain 内の access token でも動くが、数時間で失効する:
#   security find-generic-password -s "Claude Code-credentials" -w \
#     | python3 -c "import sys,json;print(json.load(sys.stdin)['claudeAiOauth']['accessToken'])"
CLAUDE_CODE_OAUTH_TOKEN=

# claude CLI の既定モデル(Corstack の CORSTACK_NETINV_MODEL 相当)
NETINV_MODEL=sonnet


# ============================================================================
# Global Overview(Central / Mist 直接 REST。MCP を経由しない)
# 詳細は instructions/05_findings.md
# ============================================================================

# ---- HPE Aruba Networking Central ----
# OAuth2 client_credentials。client_id / client_secret を HTTP Basic で
# CENTRAL_TOKEN_URL に POST して Bearer アクセストークン(有効期限 約2時間)を得る。
# 値は既存の ~/claude/central-mcp-http/.env と同じもの(あちらは変更しない)。
CENTRAL_BASE_URL=https://internal.api.central.arubanetworks.com
CENTRAL_CLIENT_ID=
CENTRAL_CLIENT_SECRET=
# 省略時は https://sso.common.cloud.hpe.com/as/token.oauth2
CENTRAL_TOKEN_URL=https://sso.common.cloud.hpe.com/as/token.oauth2
# 送出レート(req/sec)。Central の枠は 10 req/sec でアカウント全体の共有。
# central-mcp-http と取り合いになるため、既定では枠の 40% までしか使わない。
CENTRAL_RATE_PER_SEC=4
CENTRAL_RATE_BURST=4

# ---- Juniper Mist ----
# API トークン 1 本。`Authorization: Token <token>` で api.ac2.mist.com を直接叩ける。
# ~/.claude.json の mist-cloud が mcp.ai.juniper.net に Bearer で渡しているものと同じ値だが、
# Mist 本体の REST は Bearer を受け付けない(401)ので Token スキームで送る。有効期限は無い。
MIST_BASE_URL=https://api.ac2.mist.com
MIST_API_TOKEN=
# 省略すると起動時に /api/v1/self から解決する(固定しておくと 1 リクエスト減る)。
MIST_ORG_ID=
# Mist はレート制限ヘッダを返さない。ドキュメント上は 5000 req/hour/token。保守的に 2 req/sec。
MIST_RATE_PER_SEC=2
MIST_RATE_BURST=2
# アラーム集計窓(秒)。既定 86400 = 直近 24 時間。
MIST_ALARM_WINDOW_SEC=86400

# ---- ポーリング ----
# 1 巡につき HTTP 6 本(Central 3 + Mist 3)。既定 180000ms(3 分)= 0.033 req/sec。
GLOBAL_OVERVIEW_POLL_MS=300000
# 手動 refresh の最短間隔。連打しても外部 API は叩かずキャッシュを返す。
GLOBAL_OVERVIEW_MIN_REFRESH_MS=60000

# ---- サイトマップの地図タイル(85)----
# CARTO は 2026 年 8 月下旬から、キーなしのタイル要求に「API KEY REQUIRED」の透かしを入れて返す
# (HTTP 200 で返るのでエラーにはならない)。透かしを消すには無料の API キーを設定する。
#   取得: https://carto.com/basemaps/apikey/ (CARTO アカウント不要・メールで即時発行・月 500 万リクエストまで無料)
# キーはブラウザのタイル URL に ?key= として載る前提の値だが、リポジトリには書かずこの .env にだけ置く。
# 未設定でも地図は従来どおり表示される(透かしが残るだけ)。
CARTO_API_KEY=

# タイルプロバイダの差し替え(任意)。CARTO 側の都合で壊れたときの逃げ道。
# 未設定なら CARTO light_all / dark_all。Leaflet の URL テンプレート形式({s} {z} {x} {y} {r})。
# CARTO_API_KEY は *.cartocdn.com の URL にだけ付与され、他プロバイダの URL には付かない。
# 例(OpenStreetMap 標準タイル。利用規約 https://operations.osmfoundation.org/policies/tiles/ に従うこと):
#   MAP_TILE_URL_LIGHT=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#   MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
MAP_TILE_URL_LIGHT=
# ダークテーマ用。省略時は MAP_TILE_URL_LIGHT を流用する。
MAP_TILE_URL_DARK=
# 地図右下の帰属表記(HTML)。URL を差し替えたら必ずそのプロバイダの表記に合わせる。
MAP_TILE_ATTRIBUTION=
# {s} に入るサブドメイン(既定 abcd)/ 最大ズーム(既定 19)。
MAP_TILE_SUBDOMAINS=
MAP_TILE_MAX_ZOOM=

# ============================================================================
# Webhook ログ(17)— Central / Mist の Webhook を Google Apps Script が書き込んだ
# スプレッドシートを、サービスアカウントで読み取る。詳細は instructions/17_findings.md
# ============================================================================

# 対象スプレッドシートの ID(URL の /d/ と /edit の間の文字列)。
# 未設定だと Webhook ログタブは「未設定」と表示され、Sheets へのアクセスは行われない。
WEBHOOK_LOG_SPREADSHEET_ID=

# サービスアカウントの JSON 鍵。既定は secrets/sheets-service-account.json。
# 別名で置いている場合はここでパスを指定する(未指定なら secrets/ 直下の *.json を拾う)。
# 対象スプレッドシートを、この鍵の client_email に「閲覧者」で共有しておくこと。
# secrets/ は .gitignore 済み。鍵の中身は絶対にコミットしない。
WEBHOOK_LOG_SA_KEY_FILE=

# ポーリング間隔。既定 300000ms(5 分)。画面から変更した値は
# data/webhook-feed/settings.json に永続化され、起動時はそちらが優先される。
# Global Overview の GLOBAL_OVERVIEW_POLL_MS とは別設定。
WEBHOOK_FEED_POLL_MS=300000
# 手動更新(「更新」ボタン)の最短間隔。
WEBHOOK_FEED_MIN_REFRESH_MS=30000

# ---- 重大アラートの自動事前調査(Task 4)/ 関連情報の先読み(Task 5)----
# 0 にすると自動事前調査・先読みを一切行わない。
WEBHOOK_FEED_AUTO_ENABLED=1
# 1 巡(1 ポーリング)あたりの自動調査の最大件数。コスト上限。
WEBHOOK_FEED_AUTO_MAX_PER_CYCLE=3
# 受信からこの時間を超えた行では発火しない(既定 3600000ms = 60 分)。
WEBHOOK_FEED_AUTO_MAX_AGE_MS=3600000
